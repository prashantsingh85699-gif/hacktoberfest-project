# Gemini (server-side only). Empty = DEMO MODE (clearly labelled canned data)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Tavily web search (server-side only, free tier, no card). Empty = investigation returns SEARCH_UNAVAILABLE
TAVILY_API_KEY=

# Open Food Facts family requires a descriptive User-Agent
OFF_USER_AGENT=ExpiryWatchAI/1.0 (contact: your-email@example.com)

# Ambiguous numeric dates: DMY (default) or MDY
DATE_ORDER=DMY

PORT=8787
